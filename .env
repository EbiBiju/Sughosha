# ============================================================
#  SughOsha Social Auth Configuration
#  Fill in YOUR credentials below — instructions in SETUP_GUIDE.md
# ============================================================

# --- Google OAuth ---
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# --- Facebook OAuth ---
# Get these from: https://developers.facebook.com → Your App → Settings → Basic
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID_HERE
FACEBOOK_APP_SECRET=YOUR_FACEBOOK_APP_SECRET_HERE

# --- Session Security ---
# Change this to any long random string (e.g. smash your keyboard)
SESSION_SECRET=sugh0sha-super-secret-session-key-2026-change-me

# --- Server Config ---
# The base URL of your site (must match the OAuth callback URLs you register)
BASE_URL=http://localhost:8082

# Port for the auth server (separate from your static server on 8081)
AUTH_PORT=8082
